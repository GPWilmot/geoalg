def findAut15(cal, root=SedCal3):
  """Generate 32-cycle calibrations and search each in AutO+P+A. Return both."""
  cyc = [cal]
  for x in CA.Basis(15,0,1): # Generate 32-cycle
    cyc.append(x*cal*x)
  for x in reversed(range(16)):
    cyc.append(-cyc[x])
  out = []   # Generate list basis of all cals and search for all 32-cycle
  allAuts = [root] +list(SedCal3.swap(x*2) for x in AutBasis)
  for idx,tmp in enumerate(cyc):
    if tmp in allAuts:
      out.extend(((["1"] +AutNames)[allAuts.index(tmp)], idx))
  return out, cyc

if Lib.isCalc("O"):
  def allCalQuats(calCA, basisO):
    "Check assoc.cal is all quaternion rings, allCalQuats(SedCal3,O.Basis(4))."
    out = []
    arr = calCA.basisTerms()
    for idx,tri in enumerate(arr[0]):
      res = arr[1][idx]
      for el in tri:
        res *= basisO[el -1]
      out.append(res)
    return out
  _ = all(x==-1 for x in allCalQuats(SedCal3,O.Basis(4)))
  print("All SedCal3 quaternion:", _)
  if Lib.isLoaded("spin7_g2.ca"):
    _ = all(x==-1 for x in allCalQuats(triads7all(0,22),O.Basis(3)))
    print("All triads7all(0,22) quaternion:", _)

  def sedTri(oct, pullback=False):
    "Return 7-form SedCal7 terms as SedCal3 terms."
    oct = oct.basisTerms()
    arr = [[0,1,2], [0,3,4], [0,5,6], [1,3,5], [1,4,6], [2,3,6], [2,4,5]]
    tris = list(CA.Eval(list(oct[0][0][x] for x in ex)) for ex in arr)
    sgns = list(-e3o(x)[3] for x in tris)
    if pullback:
      tris = (CA.Eval(list(y+1 for y in x)) for x in arr)
    return sum(x[1] *sgns[x[0]] for x in enumerate(tris))

  om15 = (1,o1,o2,o12,o3,o13,o23,o123,o4,o14,o24,o124,o34,o134,o234,o1234)
  def e4o(x): "Map Cl(15) to 4-form automorphs"; x = x.basisTerms(); \
         return (om15[x[0][0][0]] *om15[x[0][0][1]] *x[1][0], \
                 om15[x[0][1][0]] *om15[x[0][1][1]]*x[1][1], \
                 om15[x[0][2][0]] *om15[x[0][2][1]]*x[1][2], \
                 om15[x[0][3][0]] *om15[x[0][3][1]]*x[1][3])
  def e4os(x): "Automorp.>0,1st el,signs from e4o()."; y = e4o(x); y0 = y[0]; \
         return (y0*y[1]*y[2]*y[3]*16, (1, y[1]//y0, y[2]//y0, y[3]//y0), y0)
  def e3o(x):  x = x.basisTerms(); \
         y = [om15[x[0][0][0]],om15[x[0][0][1]],om15[x[0][0][2]],0]; \
         y[3] = (y[0] *y[1] *y[2]).scalar() *x[1][0]; return y
  def e2o(x): "Map Cl(15) to 2-form automorphs"; x = x.basisTerms(); \
         return (om15[x[0][0][0]] *om15[x[0][0][1]] *x[1][0], \
                 om15[x[0][1][0]] *om15[x[0][1][1]]*x[1][1])
  print("Check all Phi(0+1+2+3) (all(e4os(x)[0]==1 & sum(e4os(x)[1]) in (0,4)):")
  PhiPart = (("O", Ovar), ("P", Pvar), ("A", Avar), ("B", Bvar), ("C", Cvar))
  print("Sign: \t0, \t1, \t2, \t3")
  for z in PhiPart: print(z[0],"\t"+"\t".join(list(str(all(sum(e4os(x)[1]) in (0,4)\
               for x in Trans(z[1], sgn))) for sgn in range(4))))

_AllNames = "List of names G, O, P, A, B, C, N for load/dump/allTables"
_AllSigns = "List of sign label pairs 0,1,2,3 for load/dump/allTables"
AllNames = ("G", "O", "P", "A", "B", "C", "N")
AllSigns = (0, 11, 22, 33, 1, 2, 3, 12, 13, 23)
def dumpLabels(sgn): return Labels(AllNames[0 if sgn < 2 else 1 \
             :7 if sgn < 2 else 6], sgn)
def loadTables(name="All"):
  """loadTables([name="All"])
     Use loadd(",".join(loadTables())) to load all tables."""
  return list("%s%d%d" %(name, x//10, x%10) for x in AllSigns)
def dumpTables(name="All"):
  """dumpTables(["name=All"])
     List allTables results using dump()."""
  for x in AllSigns: eval("%s%d%d" %(name, x//10, x%10)) \
              .dump(dumpLabels(x %10), dumpLabels(x //10))

def allTables(name="All"):
  """allTables([name="All"])
     Build and save AllXY.ca for Trans(AllNames,X/Y)**2 for X<=Y in 0..3."""
  all = (Gvar[:14], Ovar, Pvar, Avar, Bvar, Cvar, Nvar[:26])
  for idx in AllSigns:
    row = idx //10
    col = idx %10
    matName = "%s%d%d" %(name, row, col)
    rowRng = (0 if row < 2 else 1, 7 if row < 2 else 6)
    colRng = (0 if col < 2 else 1, 7 if col < 2 else 6)
    out = list(list([] for _ in all[rowRng[0]:rowRng[1]]))
    for x0,x1 in enumerate(all[rowRng[0]:rowRng[1]]):
      x2 = x0 +rowRng[0]
      for y0,y1 in enumerate(all[colRng[0]:colRng[1]]):
        y2 = y0 +colRng[0]
        if row == col:
          out[x0].append(autoTable(x2, row, y2, col, dump=2) if x0<=y0 else ".")
        else:
          out[x0].append(autoTable(x2, row, y2, col, dump=2))
    rowRng = (0 if row < 2 else 1, 7 if row < 2 else 6)
    out = Matrix(out)
    exec("global %s;%s = out" %(matName, matName))
    print("Save data %s.ca" %matName)
    filename = Calculator.fixFilename("%s.ca" %matName, True)
    Lib.save(filename, "%s" %matName, out)

def autoTable(var1, tran1=0, var2=None, tran2=None, lie=0, dump=0):
  """autoTable(var1, [tran1, var2=var1, tran2=tran1, lie=[1/2],dump])
     Lie product of vars=G2/O/P/A/B/C/Nvar[s] or index to these, lie is auto
     set, trans=sign variation (1..3 and parity change 4..7) and dump=0-2.
     Runs: Tensor.Table(Trans(var2, tran2), Trans(var1, tran1), lie=lie)).
     Return morph'd table if dump=0, else summary of autoClass() types. If 
     dump then the formatted table if printed (with labels if vars are ints).
     The tables contain (XXX for all unknows) but the autoClass() distinguishes
     Z=unknown 2-form, Y=unknown 4-form else X. Sets lie=1 or 2 for Avars."""
  if var2 is None:
    var2 = var1
  if tran2 is None:
    tran2 = tran1
  vars = (Gvar[:14], Ovar, Pvar, Avar, Bvar, Cvar, Nvar[:26])
  names = (Gname[:14], Oname, Pname, Aname, Bname, Cname[:28], Nname[:26])
  labels1 = labels2 = None
  Lib._checkType(tran1, int, "autoTable", (0, 1 if var1 in (0,6) else 7))
  Lib._checkType(tran2, int, "autoTable", (0, 1 if var2 in (0,6) else 7))
  if isinstance(var1, int) and var1 >= 0 and var1 < 7:
    labels1 = Ticks(names[var1], tran1)
    var1 = vars[var1]
  if isinstance(var2, int) and var2 >= 0 and var2 < 7:
    labels2 = Ticks(names[var2], tran2)
    var2 = vars[var2]
  Lib._checkList(var1, (CA, list, Tensor, Matrix), "autoTable")
  Lib._checkList(var2, (CA, list, Tensor, Matrix), "autoTable")
  Lib._checkType(dump, int, "autoTable", (0,2))
  if var1[:14] == Gvar[:14] and tran1:
    var1 = Gvar[21:21 +len(var1)]
  if var2[:14] == Gvar[:14] and tran1:
    var2 = Gvar[21:21 +len(var2)]
  if var1[:26] == Nvar[:26] and tran1:
    var1 = Nvar[44:44 +len(var1)]
  if var2[:26] == Nvar[:26] and tran1:
    var2 = Nvar[44:44 +len(var2)]
  useName1 = useName2 = None
  if lie == 0:
    l1 = min(len(Avar), len(var1))
    l2 = min(len(Avar), len(var2))
    isAvars = Abs(var1[:l1]) == Abs(Avar[:l1]) and \
              Abs(var2[:l2]) == Abs(Avar[:l2])
    lie = 2 if isAvars else 1
  Lib._checkType(lie, int, "autoTable", (1,2))
  mat = Tensor.Table(Trans(var2, tran2), Trans(var1, tran1), lie=lie)
  if dump > 0:
    order = ("0", "G", "O", "P", "A", "B", "C", "N")
    cnts = {"X": 0, "Y": 0, "Z": 0}
    types = mat.reduce(lambda x,y: autoClass(y, x), (set(), []))
    accum = list([] for _ in order)
    for el in types[0]:
      accum[order.index(el[0])].append(el if len(el) == 1 else el[1:])
    out = []
    if len(types[1]) > 0:
      for ch in types[1]:
        cnts[ch] += 1
      for ch,val in cnts.items():
        if val > 0:
          out.append(ch +str(val))
    for idx,el in enumerate(accum[1:]):
      if el:
        out.append(order[idx +1] +"".join(sorted(el)))
    if not out and accum[0]:
      out = "0"
    if dump == 1:
      mat.morph(OPABCvars, OPABCnames).dump(labels2, labels1)
    return "+".join(out)
  return mat.morph(OPABCvars +QRSTUVvars, OPABCnames +QRSTUVnames)

def autoClass(value, _excess=None):
  """autoClass(value)
     Return the O,P,A,B,C,GP,0 type or X if != 4 terms or XX not found."""
  out = "Z"
  if value == 0:
    out = "0"
  else:
    name = ""
    offs = 0
    sgn = -1 if -value in OPABCvars else 1
    if value in OPABCvars or sgn < 0:
      name = OPABCnames[OPABCvars.index(value *sgn)]
    elif not isinstance(value, CA) or value.grades()[2:3] == [2]:
      out = "Y"
    elif value.grades()[2:3] == [4]:
      out = "X"
      for cnt in range(4,8):
        tran = transIt(value, cnt)
        sgn = -1 if -tran in OPABCvars else 1
        if tran in OPABCvars or sgn < 0:
          name = OPABCname[OPABCvars.index(tran *sgn)]
          offs = cnt
    if name:
      if name[0] == "-":
        name = name[1:]
      if name[0] == "2":
        name = name[1:]
      if len(name) > 1 and name[1] != "'" and ord(name[1]) < 65:
        name0 = name[0].upper()
      elif ord(name[0]) >= 97:
        name0 = "P"
      else:
        name0 = "O"
      cnt = 0
      while name[-(1+cnt)] == "'":
        cnt += 1
      out = name0 +str(cnt +offs)
  if _excess is None:
    return out
  if out in ("X", "Y", "Z"):
    _excess[1].append(out)
  else:
    _excess[0].add(out)
  return _excess

def convertCal3(cal3):
  """convertCal3(cal3)
     Return the 7-form parts of 3*cal3 in 15-D as a dict."""
  baseCal = cal3.basisTerms()
  base = (SedCal3**3).basisTerms()
  tmps = dict(list((tuple(x), []) for x in base[0] if len(x)==7))
  for tri in enumerate(baseCal[0]):
    idxs = tri[1]
    for key,val in tmps.items():
      if idxs[0] in key and idxs[1] in key and idxs[2] in key:
        val.append(([idxs], [baseCal[1][tri[0]]], [[]]))
  out = {}
  for x in tmps:
    if len(tmps[x])==7:
      out[CA.Eval(x)] = sum(CA.Eval(z) for z in tmps[x])
  return out

def findRemainder3(cal3):
  """findRemainder3(cal3)
     Return the remainder of 2p(((3p+-cal3)/4)**2 +1) [+-cal3], p=7-form."""
  p = (cal3**3).pure(7)
  p = p /p.norm()
  rem = ((3*p +cal3)/4)**2 +1
  if rem:
    p = abs(p)
    rem = 2*p*(((3*p -cal3)/4)**2 +1)
    if abs(rem.copyTerms()[0][1]) != 1:
      rem = 2*p*(((3*p +cal3)/4)**2 +1) +cal3
    else:
      rem -= cal3
    return rem
  return 0
  

print("Avar^Avar cycles(7):", len(autoTable(Avar).cycles(Aname)))
